pkgname=loft
pkgver=0.1.0
pkgrel=1
pkgdesc='Local PHP and Node sites at name.test with HTTPS, served by nginx (a Herd for Omarchy)'
arch=('x86_64' 'aarch64')
url='https://github.com/bellinivitor/loft'
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'nginx' 'nss' 'openssl' 'networkmanager'
         'ca-certificates-utils' 'polkit' 'tar' 'xz' 'libnotify' 'systemd')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/loft "$pkgdir/usr/bin/loft"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/loft.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/loft.svg"
  install -Dm644 "$startdir/loft.desktop" "$pkgdir/usr/share/applications/loft.desktop"
}
